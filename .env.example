# Public Supabase config (safe to expose to the browser — protected by Row Level Security)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Hides every EN/ES language switch, including on the sign-in screens, until
# Amina has reviewed the Spanish copy (brief 11.6). Leave unset/false until then.
VITE_ES_RELEASED=false

# Optional: Sentry DSN for error tracking (brief 1.1). Leave unset to disable.
VITE_SENTRY_DSN=

# Only used by scripts/seed.mjs (server-side, never shipped to the browser).
# Get it from Supabase dashboard: Project Settings > API > service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Local-only path to extracted client report JSON, used by scripts/seedReportV2.mjs
# and scripts/registerKitFromV2.mjs. Never commit real client data to this repo —
# see .gitignore and DECISIONS.md (2026-10-19).
ELEVAME_CLIENT_DATA_DIR=/absolute/path/to/your/local/client-data
